{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["./config/wirecat/biome.base.json"],
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!pnpm-lock.yaml",
      "!package-lock.json",
      "!.worktrees",
      "!config/wirecat",
      "!spec/google",
      "!lint/baseline"
    ]
  },
  "overrides": [
    {
      "includes": ["src/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@googleapis/**", "google-auth-library"],
                    "message": "Google's SDK and auth library stay in the Google modules (google, google-api, documents, login, tokens); the rest of drive speaks its own model"
                  },
                  {
                    "group": ["@modelcontextprotocol/**"],
                    "message": "only src/mcp.ts serves MCP; commands and services do not know the protocol"
                  },
                  {
                    "group": ["proper-lockfile"],
                    "message": "src/profile-lock.ts owns the profile lock; take it through lockProfile"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/google.ts",
        "src/google-api.ts",
        "src/documents.ts",
        "src/login.ts",
        "src/tokens.ts",
        "!**/*.test.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@modelcontextprotocol/**"],
                    "message": "only src/mcp.ts serves MCP; commands and services do not know the protocol"
                  },
                  {
                    "group": ["proper-lockfile"],
                    "message": "src/profile-lock.ts owns the profile lock; take it through lockProfile"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/mcp.ts", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@googleapis/**", "google-auth-library"],
                    "message": "Google's SDK and auth library stay in the Google modules (google, google-api, documents, login, tokens); the rest of drive speaks its own model"
                  },
                  {
                    "group": ["proper-lockfile"],
                    "message": "src/profile-lock.ts owns the profile lock; take it through lockProfile"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/profile-lock.ts", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@googleapis/**", "google-auth-library"],
                    "message": "Google's SDK and auth library stay in the Google modules (google, google-api, documents, login, tokens); the rest of drive speaks its own model"
                  },
                  {
                    "group": ["@modelcontextprotocol/**"],
                    "message": "only src/mcp.ts serves MCP; commands and services do not know the protocol"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
