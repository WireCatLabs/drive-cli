{
  "command": "node",
  "args": ["../dist/bin/drive.js"],
  "cases": [
    {
      "id": "help",
      "args": ["--help"],
      "exit": 0,
      "stream": "stdout",
      "kind": "text",
      "snapshot": "help.snap"
    },
    {
      "id": "discovery",
      "args": ["commands", "api", "drive-files-get", "--json"],
      "exit": 0,
      "stream": "stdout",
      "kind": "json",
      "contains": "\"generated\""
    },
    {
      "id": "invalid-option",
      "args": ["--unknown-option"],
      "exit": 2,
      "stream": "stderr",
      "kind": "json",
      "errorCode": "validation_error"
    },
    {
      "id": "missing-generated-id",
      "args": ["default", "api", "drive-files-get"],
      "exit": 2,
      "stream": "stderr",
      "kind": "json",
      "errorCode": "validation_error"
    },
    {
      "id": "readonly-before-auth",
      "args": ["default", "--read-only", "files", "copy", "synthetic-doc"],
      "exit": 5,
      "stream": "stderr",
      "kind": "json",
      "errorCode": "permission_error"
    },
    {
      "id": "dry-run-before-auth",
      "args": ["default", "--dry-run", "api", "drive-files-get", "--file-id", "synthetic-doc", "--json"],
      "exit": 0,
      "stream": "stdout",
      "kind": "json",
      "json": {
        "item": {
          "dry_run": true,
          "method": "drive.files.get"
        }
      }
    },
    {
      "id": "missing-explicit-profile",
      "args": ["status", "--json"],
      "exit": 2,
      "stream": "stderr",
      "kind": "json",
      "errorCode": "validation_error",
      "contains": "profile.required"
    },
    {
      "id": "decision-reverse-readonly-before-auth",
      "args": ["personal", "--read-only", "facts", "reverse", "synthetic-doc", "fact:1"],
      "exit": 5,
      "stream": "stderr",
      "kind": "json",
      "errorCode": "permission_error"
    },
    {
      "id": "decision-reverse-dry-run-before-auth",
      "args": ["personal", "--dry-run", "facts", "reverse", "synthetic-doc", "fact:1", "--json"],
      "exit": 0,
      "stream": "stdout",
      "kind": "json",
      "json": {
        "item": {
          "dry_run": true,
          "effects": {
            "remote": "none",
            "local": "write"
          }
        }
      }
    }
  ],
  "mcp": {
    "args": ["default", "--read-only", "mcp"],
    "snapshot": "mcp-tools.json"
  }
}
