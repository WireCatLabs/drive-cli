{
  "command": "node",
  "args": ["../dist/bin/drive.js"],
  "cases": [
    {
      "id": "seed-previous-shared-store",
      "entry": "./previous/seed.mjs",
      "args": [],
      "exit": 0,
      "stream": "stdout",
      "kind": "json",
      "json": {
        "seeded": true
      },
      "capture": {
        "document": "/document"
      }
    },
    {
      "id": "search-upgraded-store",
      "args": ["default", "search", "budget", "--exact", "--json"],
      "exit": 0,
      "stream": "stdout",
      "diagnostic": "the store moved to schema 40; every other WireCat CLI that uses it needs a version that speaks it — run `<cli> upgrade` for each\n",
      "kind": "json",
      "json": {
        "item": {
          "hits": [
            {
              "ref": "{{document}}"
            }
          ]
        }
      },
      "allowSensitiveOutput": true
    },
    {
      "id": "tags-survive",
      "args": ["default", "tags", "list", "synthetic-doc", "--json"],
      "exit": 0,
      "stream": "stdout",
      "kind": "json",
      "json": {
        "items": [{ "tag": "budget" }]
      }
    },
    {
      "id": "notes-survive",
      "args": ["default", "notes", "list", "synthetic-doc", "--json"],
      "exit": 0,
      "stream": "stdout",
      "kind": "json",
      "contains": "Synthetic owner memo",
      "allowSensitiveOutput": true
    },
    {
      "id": "fact-memories-survive-as-facts",
      "args": ["default", "facts", "list", "synthetic-doc", "--json"],
      "exit": 0,
      "stream": "stdout",
      "kind": "json",
      "contains": "Synthetic budget fact",
      "allowSensitiveOutput": true
    },
    {
      "id": "mirror-state-survives",
      "args": ["default", "mirrors", "status", "--json"],
      "exit": 0,
      "stream": "stdout",
      "kind": "json",
      "json": {
        "items": [{ "create": 1, "update": 0, "unchanged": 1 }]
      }
    },
    {
      "id": "config-of-0.51-loads",
      "args": ["doctor", "--json"],
      "exit": 0,
      "stream": "stdout",
      "kind": "json",
      "json": { "item": { "config": { "found": true, "issues": [] }, "profiles": ["default", "work"] } }
    },
    {
      "id": "sessions-of-0.51-listed",
      "args": ["session", "list", "--json"],
      "exit": 0,
      "stream": "stdout",
      "kind": "json",
      "json": {
        "item": {
          "items": [
            { "profile": "default", "selected_folders": 0, "storage": "keyring" },
            { "profile": "work", "selected_folders": 1, "storage": "file" }
          ]
        }
      }
    }
  ]
}
