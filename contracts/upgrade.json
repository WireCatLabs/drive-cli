{
  "command": "node",
  "args": ["../dist/bin/drive.js"],
  "cases": [
    {
      "id": "seed-previous-shared-store",
      "entry": "./previous/seed.mjs",
      "args": [],
      "exit": 0,
      "stream": "stdout",
      "kind": "json",
      "json": { "seeded": true },
      "capture": { "document": "/document" }
    },
    {
      "id": "search-upgraded-store",
      "args": ["search", "budget", "--exact", "--json"],
      "exit": 0,
      "stream": "stdout",
      "kind": "json",
      "json": { "hits": [{ "ref": "{{document}}" }] },
      "allowSensitiveOutput": true
    },
    {
      "id": "tags-survive",
      "args": ["tags", "list", "synthetic-doc", "--json"],
      "exit": 0,
      "stream": "stdout",
      "kind": "json",
      "json": { "tags": ["budget"] }
    },
    {
      "id": "notes-survive",
      "args": ["notes", "list", "synthetic-doc", "--json"],
      "exit": 0,
      "stream": "stdout",
      "kind": "json",
      "contains": "Synthetic owner memo",
      "allowSensitiveOutput": true
    },
    {
      "id": "memories-survive",
      "args": ["memories", "list", "synthetic-doc", "--scope", "work", "--json"],
      "exit": 0,
      "stream": "stdout",
      "kind": "json",
      "contains": "Synthetic budget fact",
      "allowSensitiveOutput": true
    }
  ]
}
