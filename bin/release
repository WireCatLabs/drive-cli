#!/usr/bin/env sh
set -eu

cd "$(dirname "$0")/.."
[ "$#" -eq 0 ] || { echo "usage: bin/release" >&2; exit 2; }
git fetch -q origin
[ "$(git branch --show-current)" = main ] || { echo "run from main" >&2; exit 1; }
[ -z "$(git status --porcelain --untracked-files=no)" ] || { echo "uncommitted changes" >&2; exit 1; }
[ "$(git rev-parse HEAD)" = "$(git rev-parse origin/main)" ] || { echo "update main to origin/main first" >&2; exit 1; }
. ./config/wirecat/release-lock.sh
wirecat_release_lock "${WIRECAT_RELEASE_WAIT_SECONDS:-0}"
git fetch -q origin
[ "$(git rev-parse HEAD)" = "$(git rev-parse origin/main)" ] || { echo "main changed while waiting; review and update main before releasing" >&2; exit 1; }
version=$(node -p 'require("./package.json").version')
# A session that merges after the version was dated, but before it was published, adds Unreleased above it.
# --land folds on a fresh main through its own pull request, and folds again once if main moves under it.
# cli-dev is pinned rather than taken from the dependencies: cli-core accepts only an older cli-base.
folded=""
npm view "@wirecat/drive-cli@$version" version --prefer-online >/dev/null 2>&1 ||
  folded=$(npx -y -p @wirecat/cli-base@0.36.0 cli-dev changelog fold --land --version "$version")
[ -z "$folded" ] || echo "$folded"
top=$(sed -n '/^## /{p;q;}' CHANGELOG.md)
case "$top" in
  "## $version — "*) ;;
  *) echo "date the top changelog section for $version before releasing" >&2; exit 1 ;;
esac
if npm view "@wirecat/drive-cli@$version" version --prefer-online >/dev/null 2>&1; then
  echo "$version is already published; prepare a new version in a pull request" >&2
  exit 1
fi
last_run() {
  gh run list --workflow release.yml --branch main --event workflow_dispatch --limit 1 \
    --json databaseId --jq '.[0].databaseId // ""'
}
previous=$(last_run)
gh workflow run release.yml --ref main
run=""
for _ in $(seq 30); do
  run=$(last_run)
  [ -n "$run" ] && [ "$run" != "$previous" ] && break
  run=""
  sleep 2
done
[ -n "$run" ] || { echo "release dispatch not found; check GitHub Actions" >&2; exit 1; }
watch_release() {
  while ! gh run watch "$run" --exit-status; do
    # GitHub can interrupt a watcher with HTTP 500 while publication continues.
    release_state=$(gh run view "$run" --json status,conclusion --jq '.status + ":" + .conclusion' 2>/dev/null || true)
    case "$release_state" in
      completed:success) return 0 ;;
      completed:*) return 1 ;;
      *) echo "release watcher interrupted; retrying existing run $run" >&2; sleep 10 ;;
    esac
  done
}
if ! watch_release; then
  echo "release failed; inspect: gh run view $run --log-failed" >&2
  echo "for an unpublished package, check the first-publication setup in docs/dev/RELEASING.md" >&2
  exit 1
fi
npm view "@wirecat/drive-cli@$version" version --prefer-online
git fetch -q --tags origin
git rev-parse --verify "refs/tags/v$version" >/dev/null
echo "published @wirecat/drive-cli@$version"
