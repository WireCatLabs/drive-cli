#!/usr/bin/env node
// The release's live check against real Google Drive (WC-TEST-18, WC-REL-17), run by the owner on the release branch.
// It prints what the test account must hold, shows the Google account the profile is signed in to and asks first,
// runs scripts/live.sh, records the pass in docs/dev/live-checks.txt and, when the branch has an open pull request,
// commits the record, pushes it and adds its line to the pull request's Conformance section. bin/release refuses a
// version without that record.
//
//   bin/live <profile>
//
// The profile is a drive profile signed in to a test Google account, never one that matters. Sign it in once:
//   drive <profile> session start --grant write
// The sign-in stays in the keyring entry `service drive-cli account <profile>` and is used by every later run; this
// script never reads it. `drive <profile> session end` signs the profile out when it is no longer needed.
// Linux and macOS: it runs scripts/live.sh with bash. A version whose shipped code already has a record is not checked
// again.
import { execFileSync, spawnSync } from "node:child_process"
import { existsSync, readFileSync, realpathSync } from "node:fs"
import { join, resolve } from "node:path"
import { createInterface } from "node:readline/promises"

const ROOT = resolve(import.meta.dirname, "..")
const PACKAGE_JSON = join(ROOT, "package.json")
const LIVE_CHECK = join(ROOT, "scripts/live.sh")
const RECORDS = join(ROOT, "docs/dev/live-checks.txt")
const DRIVE = join(ROOT, "dist/bin/drive.js")

const fail = (message) => {
  process.stderr.write(`live: ${message}\n`)
  process.exit(1)
}

const run = (command, args, options = {}) =>
  spawnSync(command, args, { cwd: ROOT, encoding: "utf8", stdio: ["ignore", "pipe", "inherit"], ...options })
const git = (...args) => execFileSync("git", args, { cwd: ROOT, encoding: "utf8" }).trim()
const drive = (...args) => run("node", [DRIVE, ...args, "--json"], { stdio: ["ignore", "pipe", "pipe"] })

// The lines of scripts/live.sh that start with `# Needs:` say what the test account must hold.
const needs = () =>
  readFileSync(LIVE_CHECK, "utf8")
    .split("\n")
    .filter((line) => line.startsWith("# Needs:"))
    .map((line) => `  - ${line.slice("# Needs:".length).trim()}`)

export const withConformance = (body, line) => {
  const entry = `- Live check: \`${line}\``
  if (body.includes(line)) return body
  const heading = /^## Conformance[ \t]*$/m.exec(body)
  if (!heading) return `${body.replace(/\s*$/, "")}\n\n## Conformance\n\n${entry}\n`
  const at = heading.index + heading[0].length
  return `${body.slice(0, at)}\n\n${entry}${body.slice(at).replace(/^\n+/, "\n")}`
}

const recordOf = (version) =>
  existsSync(RECORDS)
    ? readFileSync(RECORDS, "utf8")
        .split("\n")
        .findLast((line) => line.startsWith(`${version} `))
    : undefined

// The record names the code that ran, so it must be the committed code of the pull request's branch on GitHub.
const requireCurrentBranch = () => {
  if (git("status", "--porcelain", "--", "src", "package.json", "pnpm-lock.yaml")) {
    fail("commit src, package.json and pnpm-lock.yaml first: the record names the committed code")
  }
  git("fetch", "-q", "origin")
  const upstream = run("git", ["rev-parse", "@{u}"], { stdio: ["ignore", "pipe", "ignore"] })
  if (upstream.status === 0 && upstream.stdout.trim() !== git("rev-parse", "HEAD")) {
    fail("this branch differs from its copy on GitHub: pull or push first, so the check runs on the code under review")
  }
}

const profiles = () => {
  const listed = drive("session", "list")
  return listed.status === 0 ? JSON.parse(listed.stdout).item.items.map((row) => row.profile) : []
}

// Who the profile is signed in to, from Google itself, so the owner sees which account the check will change.
const accountOf = (profile) => {
  const about = drive(profile, "api", "drive-about-get", "--fields", "user")
  if (about.status !== 0)
    fail(`${profile} cannot read Google Drive; sign it in to the test account with\n  drive ${profile} session start --grant write`)
  return JSON.parse(about.stdout).item?.user?.email_address ?? "an account Google did not name"
}

const check = async (profile, version) => {
  if (!existsSync(LIVE_CHECK)) fail(`${LIVE_CHECK} is missing`)
  if (!process.stdin.isTTY) fail("run it in a terminal: it asks before it uses the account")
  requireCurrentBranch()
  if (run("pnpm", ["-s", "build"], { stdio: ["ignore", "ignore", "inherit"] }).status !== 0) fail("pnpm build failed")
  const known = profiles()
  if (!known.includes(profile))
    fail(`no profile ${profile}; profiles here: ${known.join(", ") || "none"}. Sign in a test account first with\n` +
      `  drive ${profile} session start --grant write`)
  process.stdout.write(
    [
      `The live check ${LIVE_CHECK} changes Google Drive as profile ${profile}, signed in to ${accountOf(profile)}.`,
      "It needs:",
      ...needs(),
      "",
    ].join("\n"),
  )
  const rl = createInterface({ input: process.stdin, output: process.stdout })
  const answer = await rl.question("Run it? [y/N] ")
  rl.close()
  if (!/^y(es)?$/i.test(answer.trim())) fail("nothing done")
  if (run("bash", [LIVE_CHECK, profile], { stdio: ["ignore", "inherit", "inherit"] }).status !== 0) {
    fail("the live check failed: no record")
  }
  if (run("pnpm", ["exec", "cli-dev", "live", "record", "--script", "scripts/live.sh"]).status !== 0) {
    fail("cli-dev live record failed")
  }
  return recordOf(version)
}

const main = async () => {
  const [profile] = process.argv.slice(2)
  if (!profile || profile === "--help" || profile === "-h") {
    process.stdout.write(`Usage: ${join(ROOT, "bin/live")} <profile of a test Google account>\n`)
    process.exitCode = profile ? 0 : 2
    return
  }
  const { version } = JSON.parse(readFileSync(PACKAGE_JSON, "utf8"))
  const current = run("pnpm", ["exec", "cli-dev", "live", "check", "--version", version], { stdio: "ignore" })
  const record = current.status === 0 ? recordOf(version) : await check(profile, version)
  if (!record) fail(`no record for ${version} in ${RECORDS}`)

  const view = run("gh", ["pr", "view", "--json", "url,state,body"], { stdio: ["ignore", "pipe", "ignore"] })
  const pr = view.status === 0 ? JSON.parse(view.stdout) : undefined
  if (pr?.state !== "OPEN") {
    process.stdout.write(`Passed: ${record}\nCommit ${RECORDS} in the release pull request.\n`)
    return
  }
  if (git("status", "--porcelain", "--", RECORDS)) {
    git("add", "--", RECORDS)
    git("commit", "-q", "-m", `chore(release): live check of ${version}`, "--", RECORDS)
  }
  // Every time, not only after a commit: a push that failed on an earlier run is sent now.
  git("push", "-q", "origin", "HEAD")
  const body = withConformance(pr.body ?? "", record)
  const edit = { input: body, stdio: ["pipe", "ignore", "inherit"] }
  if (body !== pr.body && run("gh", ["pr", "edit", pr.url, "--body-file", "-"], edit).status !== 0) {
    fail(`the record is pushed, but ${pr.url}'s description was not changed: add it under Conformance by hand`)
  }
  process.stdout.write(`Passed: ${record}\nCommitted to ${pr.url} and named in its Conformance section.\n`)
}

if (process.argv[1] && realpathSync(process.argv[1]) === import.meta.filename) await main()
