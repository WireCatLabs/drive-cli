#!/usr/bin/env sh
# One live check of local images in mirrors (DRV-11): pushes a synthetic Markdown file with one PNG
# into a new Doc in FOLDER, then syncs again, which must send nothing. Writes to your Google Drive.
#
#   bin/live-check-mirror-image <profile> <tunnel https address> <Drive folder id or URL> [port]
#
# The tunnel must forward to the port (default 8765) and drive mcp --http must not hold it.
set -eu
if [ $# -lt 3 ]; then
  echo "usage: bin/live-check-mirror-image <profile> <https://<name>.ts.net> <Drive folder id or URL> [port]" >&2
  exit 2
fi
profile=$1
public_url=$2
folder=$3
port=${4:-8765}
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
drive() { node "$root/dist/bin/drive.js" "$profile" "$@"; }

work=$(mktemp -d)
mkdir "$work/pics"
printf '%s' 'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8DwHwAFBQIAX8jx0gAAAABJRU5ErkJggg==' |
  base64 -d >"$work/pics/dot.png"
printf '# Mirror image check\n\nA synthetic file from drive-cli bin/live-check-mirror-image.\n\n![dot](pics/dot.png)\n' \
  >"$work/image-check.md"

id=$(drive --json mirrors add "$work" --parent "$folder" |
  node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>console.log(JSON.parse(s).item.id))')
cleanup() { drive mirrors remove "$id" >/dev/null || true; }
trap cleanup EXIT

echo "first sync: expect created image-check.md and no warning"
drive mirrors sync "$id" --public-url "$public_url" --port "$port"
echo "second sync: expect nothing created or sent"
drive mirrors sync "$id" --public-url "$public_url" --port "$port"
echo "Open the Doc in $folder and check the dot image is there. The mirror is removed; the Doc and $work stay."
