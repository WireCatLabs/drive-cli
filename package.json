{
  "name": "@wirecat/drive-cli",
  "version": "0.3.0",
  "description": "Google Drive and Docs sync, Markdown snapshots and local search",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^22.16.0 || >=24"
  },
  "packageManager": "pnpm@11.20.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WireCatLabs/drive-cli.git"
  },
  "bin": {
    "drive": "dist/bin/drive.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "node --experimental-strip-types scripts/generate.ts && pnpm build && node --experimental-strip-types scripts/commands.ts",
    "generate:check": "node --experimental-strip-types scripts/generate.ts --check && pnpm build && node --experimental-strip-types scripts/commands.ts --check",
    "spec:sync": "node --experimental-strip-types scripts/sync-spec.ts",
    "contracts:check": "cli-contract contracts/plan.json",
    "contracts:upgrade": "pnpm --dir contracts/previous install --frozen-lockfile --ignore-scripts && cli-contract contracts/upgrade.json",
    "security:no-leak": "cli-testing security no-leak . contracts/no-leak.json",
    "build": "tsc --build --force",
    "typecheck": "tsc --build --force --emitDeclarationOnly && tsc -p tsconfig.test.json && tsc -p tsconfig.scripts.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "smoke:bun": "bun scripts/smoke.ts",
    "prepublishOnly": "pnpm build",
    "docs:check": "pnpm docs:lint",
    "docs:lint": "markdownlint-cli2",
    "ci:quick": "pnpm typecheck",
    "standards:check": "node config/wirecat/check.mjs",
    "smoke": "node --experimental-strip-types scripts/smoke.ts",
    "docs:spell": "cspell lint --config cspell.json --no-progress README.md",
    "prepare": "lefthook install || true",
    "lint:commands": "pnpm build && cli-dev lint --cli dist/bin/drive.js"
  },
  "dependencies": {
    "@bomb.sh/tab": "0.0.22",
    "@googleapis/docs": "14.1.0",
    "@googleapis/drive": "26.0.2",
    "@googleapis/driveactivity": "11.0.1",
    "@modelcontextprotocol/server": "2.1.0",
    "@wirecat/cli-base": "0.26.0",
    "@wirecat/cli-core": "0.262.0",
    "commander": "15.0.0",
    "google-auth-library": "11.2.0",
    "mammoth": "1.13.0",
    "proper-lockfile": "4.1.2",
    "unpdf": "1.8.1",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cspell/dict-en-gb": "5.0.34",
    "@cspell/dict-es-es": "3.0.9",
    "@cspell/dict-ru_ru": "2.3.3",
    "@types/node": "^22.20.5",
    "@types/proper-lockfile": "4.1.4",
    "@vitest/coverage-v8": "^5.0.3",
    "@wirecat/cli-testing": "0.4.0",
    "cspell": "10.3.6",
    "lefthook": "2.1.16",
    "markdownlint-cli2": "0.23.3",
    "rumdl": "^0.2.78",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
