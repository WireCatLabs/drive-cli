{
  "name": "@wirecat/drive-cli",
  "version": "0.43.0",
  "description": "Google Drive and Docs sync, Markdown snapshots and local search",
  "mcpName": "dev.wirecat/drive-cli",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^22.16.0 || >=24"
  },
  "packageManager": "pnpm@11.28.8",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WireCatLabs/drive-cli.git"
  },
  "bin": {
    "drive": "dist/bin/drive.js"
  },
  "files": [
    "dist",
    "scenarios",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "node --experimental-strip-types scripts/generate.ts && pnpm build && node --experimental-strip-types scripts/commands.ts",
    "generate:check": "node --experimental-strip-types scripts/generate.ts --check && pnpm build && node --experimental-strip-types scripts/commands.ts --check",
    "spec:sync": "node --experimental-strip-types scripts/sync-spec.ts",
    "contracts:check": "cli-contract contracts/plan.json",
    "contracts:upgrade": "pnpm --dir contracts/previous install --frozen-lockfile --ignore-scripts && cli-contract contracts/upgrade.json",
    "security:no-leak": "cli-testing security no-leak . contracts/no-leak.json",
    "build": "tsc --build --force && cli-dev bundle --bin dist/bin/drive.js --external '@googleapis/*' --external google-auth-library",
    "typecheck": "tsc --build --force --emitDeclarationOnly && tsc -p tsconfig.test.json && tsc -p tsconfig.scripts.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "smoke:bun": "bun scripts/smoke.ts && bun scripts/smoke-bundle.ts",
    "smoke:node": "node --experimental-strip-types scripts/smoke-bundle.ts",
    "prepublishOnly": "pnpm build",
    "docs:check": "node --experimental-strip-types scripts/docs-check.ts && cspell --no-progress --no-summary README.md 'docs/*.md' && rumdl check --config config/wirecat/rumdl.toml --exclude docs/dev/API_COVERAGE.md,docs/commands.md README.md CLAUDE.md docs/*.md docs/dev/*.md && pnpm docs:lint",
    "docs:lint": "markdownlint-cli2",
    "ci:quick": "pnpm typecheck && pnpm lint:commands",
    "standards:check": "node config/wirecat/check.mjs",
    "smoke": "node --experimental-strip-types scripts/smoke.ts",
    "docs:spell": "cspell lint --config cspell.json --no-progress README.md",
    "prepare": "lefthook install || true",
    "lint:commands": "pnpm build && cli-dev lint --cli dist/bin/drive.js",
    "version:check": "cli-dev version",
    "version:sync": "cli-dev version --sync",
    "package:check": "node --experimental-strip-types scripts/package-check.ts",
    "test:matrix:check": "cli-dev test-matrix --program scripts/command-program.ts --untested scripts/test-matrix-untested.ts --name drive --check && git diff --exit-code -- docs/dev/test-matrix.md",
    "test:matrix": "vitest run >/dev/null && pnpm build >/dev/null && pnpm test:matrix:check"
  },
  "dependencies": {
    "@bomb.sh/tab": "0.0.22",
    "@googleapis/docs": "14.1.1",
    "@googleapis/drive": "27.0.0",
    "@googleapis/driveactivity": "11.0.1",
    "@googleapis/sheets": "18.1.1",
    "@modelcontextprotocol/server": "2.4.0",
    "@wirecat/cli-base": "0.63.0",
    "@wirecat/cli-core": "0.453.0",
    "commander": "15.0.0",
    "google-auth-library": "11.3.1",
    "mammoth": "1.13.0",
    "proper-lockfile": "4.1.2",
    "unpdf": "1.9.1",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@cspell/dict-en-gb": "5.0.38",
    "@cspell/dict-es-es": "3.0.9",
    "@cspell/dict-ru_ru": "2.3.4",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^22.20.5",
    "@types/proper-lockfile": "4.1.4",
    "@vitest/coverage-v8": "^5.0.5",
    "@wirecat/cli-testing": "0.5.3",
    "cspell": "10.4.0",
    "esbuild": "0.28.2",
    "lefthook": "2.2.2",
    "markdownlint-cli2": "0.24.0",
    "rumdl": "^0.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
